# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - SISTEMA FARMACIA CUCEI
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renombralo como ".env" en la raiz del proyecto.
# 2. Si te conectas mediante un tunel de Pinggy.io, puedes pegar el enlace
#    directamente en DB_URL o usar el boton "Configurar Servidor / Pinggy" en el Login.
# ==============================================================================

# --- 1. CONEXION A BASE DE DATOS MYSQL (LOCAL O TUNEL PINGGY.IO) ---
# Opcion A: Enlace directo del tunel TCP de Pinggy (sobreescribe DB_HOST y DB_PORT si se define)
# Ejemplo: DB_URL=tcp://rnxyz-189-203-10-20.a.free.pinggy.link:43219
DB_URL=

# Opcion B: Configuracion por parametros individuales (por defecto Localhost XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dbfarmacia

# --- 2. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI API) ---
# Clave para el Asistente Farmaceutico en el modulo de Ventas (POS)
# Tambien puede colocarse en Recursos/Menus/Ventas/Gemini_api.env
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
gemini_api=tu_api_key_de_gemini_aqui

# --- 3. SERVIDOR DE CORREO ELECTRONICO (SMTP GMAIL) ---
# Utilizado para enviar facturas CFDI 4.0 a clientes y ordenes de compra a proveedores
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo_farmacia@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_gmail
